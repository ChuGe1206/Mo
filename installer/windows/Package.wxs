<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" RequiredVersion="4.0.6">
  <!--
    Development-only package authoring. Payload.generated.wxs is materialized
    from a verified stage and supplies MoPayloadComponents plus fixed file ids.
    Machine TSF mutations run elevated, in-script, with explicit rollback and
    commit markers. No custom action enables Mo for a user or makes it default.
  -->
  <Package
      Name="Mo (墨) 输入法 — development build"
      Manufacturer="Mo Project"
      Version="$(var.ProductVersion)"
      UpgradeCode="{8245E1F5-8BC4-4D41-BA9C-65F30CEBCB32}"
      Scope="perMachine"
      Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Mo development build is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPCOMMENTS" Value="Unsigned, non-redistributable development package." />
    <?if $(var.IncludeFaultInjection) = 1 ?>
    <Property Id="MO_TEST_FAIL_AFTER_MACHINE_PROFILE" Secure="yes" />
    <?endif?>
    <Launch Condition="NOT RollbackDisabled"
        Message="Mo setup requires Windows Installer rollback to protect the TSF registration transaction." />

    <!-- Embedded copy remains runnable during uninstall commit/rollback after RemoveFiles. -->
    <Binary Id="MoRegistrarCustomAction" SourceFile="$(var.StagePayload)\bin\mo-tip-registrar.exe" />

    <CustomAction Id="RollbackInstallMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="rollback-install-machine-profile-fixed" Execute="rollback"
        Impersonate="no" Return="ignore" />
    <CustomAction Id="InstallNewMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="install-new-machine-profile-fixed" Execute="deferred"
        Impersonate="no" Return="check" />
    <CustomAction Id="InstallMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="install-machine-profile-fixed" Execute="deferred"
        Impersonate="no" Return="check" />
    <?if $(var.IncludeFaultInjection) = 1 ?>
    <CustomAction Id="DevelopmentFailAfterMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="development-test-fail-fixed" Execute="deferred"
        Impersonate="no" Return="check" />
    <?endif?>
    <CustomAction Id="CommitInstallMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="commit-install-machine-profile-fixed" Execute="commit"
        Impersonate="no" Return="check" />

    <CustomAction Id="RollbackRemoveMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="rollback-remove-machine-profile-fixed" Execute="rollback"
        Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="remove-machine-profile-fixed" Execute="deferred"
        Impersonate="no" Return="check" />
    <CustomAction Id="CommitRemoveMachineProfile" BinaryRef="MoRegistrarCustomAction"
        ExeCommand="commit-remove-machine-profile-fixed" Execute="commit"
        Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <!-- A rollback action must precede the deferred mutation it reverses. -->
      <Custom Action="RollbackRemoveMachineProfile" Before="RemoveMachineProfile"
          Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveMachineProfile" Before="CommitRemoveMachineProfile"
          Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CommitRemoveMachineProfile" Before="RemoveFiles"
          Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

      <Custom Action="RollbackInstallMachineProfile" After="InstallFiles"
          Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="InstallNewMachineProfile" After="RollbackInstallMachineProfile"
          Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="InstallMachineProfile" After="InstallNewMachineProfile"
          Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE~=&quot;ALL&quot;" />
      <?if $(var.IncludeFaultInjection) = 1 ?>
      <Custom Action="DevelopmentFailAfterMachineProfile" After="InstallMachineProfile"
          Condition="MO_TEST_FAIL_AFTER_MACHINE_PROFILE = &quot;1&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CommitInstallMachineProfile" After="DevelopmentFailAfterMachineProfile"
          Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <?else?>
      <Custom Action="CommitInstallMachineProfile" After="InstallMachineProfile"
          Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <?endif?>
    </InstallExecuteSequence>

    <Feature Id="MoDevelopment" Title="Mo development payload" Level="1">
      <ComponentGroupRef Id="MoPayloadComponents" />
    </Feature>
  </Package>
</Wix>
