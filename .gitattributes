* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cpp text eol=crlf
*.hpp text eol=crlf
*.h text eol=crlf
*.wxs text eol=crlf

# Unified diffs require their single-space blank context lines. Keep them LF on
# Windows too, so they apply to the hash-pinned Git archives without CRLF drift.
*.patch text eol=lf whitespace=-blank-at-eol
