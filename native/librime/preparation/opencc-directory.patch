+ConverterPtr Config::NewFromFileInDirectory(const std::string& fileName,
+                                          const std::string& directory) {
+  ConfigInternal* impl = reinterpret_cast<ConfigInternal*>(internal);
+  if (directory.empty()) throw InvalidFormat("Mo resource directory is empty");
+  impl->mo_directory = directory;
+  std::unique_ptr<FILE, decltype(&fclose)> file(
+      mo::OpenResourceFile(directory, fileName, ".json", 64 * 1024), &fclose);
+  std::string content;
+  char buffer[4096];
+  size_t count;
+  while ((count = fread(buffer, 1, sizeof(buffer), file.get())) != 0) {
+    if (content.size() + count > 64 * 1024) throw InvalidFormat("Mo config size rejected");
+    content.append(buffer, count);
+  }
+  if (ferror(file.get())) throw InvalidFormat("Mo config read failed");
+  if (content.find('\0') != std::string::npos) throw InvalidFormat("Mo config contains NUL");
+  // The strict branch copies JSON strings into the parser's own storage.
+  return NewFromString(content, std::vector<std::string>{});
+}
