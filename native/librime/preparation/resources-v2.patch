@@ -57,6 +59,25 @@ class ConcreteEngine : public Engine {
 
 // implementations
 
+bool ConcreteEngine::PrepareResources() {
+  if (!schema_ || schema_->schema_id() != "rime_ice" || !context_
+      || !context_->input().empty() || context_->IsComposing()) {
+    return false;
+  }
+  size_t prepared = 0;
+  unsigned kinds = 0;
+  for (const auto& filter : filters_) {
+    if (auto* simplifier = dynamic_cast<Simplifier*>(filter.get())) {
+      const unsigned kind = simplifier->PrepareResources();
+      if (!kind || (kinds & kind)) { return false; }
+      kinds |= kind;
+      ++prepared;
+    }
+  }
+  // The locked default schema has Emoji and traditionalization filters.
+  return prepared == 2 && kinds == 3u;
+}
+
 Engine* Engine::Create() {
   return new ConcreteEngine;
 }
