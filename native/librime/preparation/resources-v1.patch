+bool Session::PrepareResources() {
+  return engine_ && engine_->active_engine() == engine_.get()
+      && commit_text_.empty() && engine_->PrepareResources();
+}
+
+bool PrepareResourcesForSession(SessionId id) {
+  auto& service = Service::instance();
+  if (service.disabled()) { return false; }
+  const auto session = service.GetSession(id);
+  return session && session->PrepareResources();
+}
